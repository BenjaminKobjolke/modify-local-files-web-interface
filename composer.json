{
    "name": "xida/modify-local-files-web-interface",
    "description": "Password-protected web interface to edit or append to configured local text files",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/BenjaminKobjolke/php-simple-login.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/BenjaminKobjolke/php-localization.git"
        }
    ],
    "require": {
        "php": "^8.5",
        "benjaminkobjolke/php-simple-login": "dev-main",
        "xida/php-localization": "dev-main",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "slim/twig-view": "^3.4",
        "slim/csrf": "^1.5",
        "monolog/monolog": "^3.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    }
}
